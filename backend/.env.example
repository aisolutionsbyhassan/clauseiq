# =============================================================================
# ClauseIQ — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your local environment.
# Never commit .env to version control.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://clauseiq_user:your_password@localhost:5432/clauseiq_db

# --- JWT Authentication ---
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# --- Google Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key

# --- ChromaDB ---
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=clauseiq_chunks

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIRECTORY=./storage

# --- Document Processing ---
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# --- RAG / Retrieval ---
RETRIEVAL_TOP_K=5

# --- Embedding Model ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Dashboard ---
DASHBOARD_RECENT_UPLOADS_LIMIT=5

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173"]

# --- App ---
APP_NAME=ClauseIQ
APP_VERSION=0.1.0
DEBUG=true
